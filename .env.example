# Environment variables
# Copy this file to .env and fill in your values

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Set to 'true' to display demo account credential hints on the login page
PUBLIC_DEMO_MODE=false

# ⚠️ SENSITIVE PRIVATE KEY — NEVER EXPOSE TO CLIENT OR COMMIT TO REPOSITORY.
# Used exclusively on the server (src/lib/server/) for operations that bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
